{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohnScheuer/vllm-multinode-diagnostics/schema/benchmark_artifact_schema.json",
  "title": "MultiNodeVLLMBenchmarkArtifact",
  "description": "Reproducible benchmark artifact for distributed vLLM inference experiments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "timestamp_utc",
    "metadata",
    "topology",
    "model",
    "parallelism",
    "workload",
    "sweeps",
    "handshake_telemetry"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "framework_versions"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": ["string", "null"]
        },
        "availability_zone": {
          "type": ["string", "null"]
        },
        "instance_type": {
          "type": ["string", "null"]
        },
        "ami_id": {
          "type": ["string", "null"]
        },
        "framework_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "vllm",
            "ray",
            "torch",
            "cuda_runtime",
            "nvidia_driver"
          ],
          "properties": {
            "python": {
              "type": "string"
            },
            "vllm": {
              "type": "string"
            },
            "vllm_git_sha": {
              "type": ["string", "null"]
            },
            "ray": {
              "type": "string"
            },
            "torch": {
              "type": "string"
            },
            "cuda_runtime": {
              "type": "string"
            },
            "cuda_toolkit": {
              "type": ["string", "null"]
            },
            "nccl": {
              "type": ["string", "null"]
            },
            "nvidia_driver": {
              "type": "string"
            }
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_count",
        "gpus_per_node",
        "gpu_model",
        "gpu_memory_mb",
        "compute_capability",
        "network"
      ],
      "properties": {
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "gpus_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_model": {
          "type": "string",
          "minLength": 1
        },
        "gpu_memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "compute_capability": {
          "type": "string"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "interface"
          ],
          "properties": {
            "transport": {
              "type": "string",
              "enum": [
                "TCP",
                "RDMA",
                "INFINIBAND",
                "UNKNOWN"
              ]
            },
            "interface": {
              "type": "string"
            },
            "efa_enabled": {
              "type": ["boolean", "null"]
            },
            "baseline_bandwidth_gbps": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "max_bandwidth_gbps": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["string", "null"]
        },
        "dtype": {
          "type": "string"
        },
        "max_model_len": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tensor_parallel_size",
        "pipeline_parallel_size",
        "data_parallel_size"
      ],
      "properties": {
        "tensor_parallel_size": {
          "type": "integer",
          "minimum": 1
        },
        "pipeline_parallel_size": {
          "type": "integer",
          "minimum": 1
        },
        "data_parallel_size": {
          "type": "integer",
          "minimum": 1
        },
        "distributed_executor_backend": {
          "type": ["string", "null"]
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency_levels",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "concurrency_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "request_count_per_level": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "warmup_requests": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "sweeps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concurrency",
          "input_tokens",
          "output_tokens",
          "request_throughput_rps",
          "output_throughput_tok_per_sec",
          "ttft_ms_p50",
          "ttft_ms_p95",
          "ttft_ms_p99",
          "tpot_ms_p50",
          "tpot_ms_p95",
          "tpot_ms_p99"
        ],
        "properties": {
          "concurrency": {
            "type": "integer",
            "minimum": 1
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "request_throughput_rps": {
            "type": "number",
            "minimum": 0
          },
          "input_throughput_tok_per_sec": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "output_throughput_tok_per_sec": {
            "type": "number",
            "minimum": 0
          },
          "ttft_ms_p50": {
            "type": "number",
            "minimum": 0
          },
          "ttft_ms_p95": {
            "type": "number",
            "minimum": 0
          },
          "ttft_ms_p99": {
            "type": "number",
            "minimum": 0
          },
          "tpot_ms_p50": {
            "type": "number",
            "minimum": 0
          },
          "tpot_ms_p95": {
            "type": "number",
            "minimum": 0
          },
          "tpot_ms_p99": {
            "type": "number",
            "minimum": 0
          },
          "e2e_latency_ms_p50": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "e2e_latency_ms_p95": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "e2e_latency_ms_p99": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "gpu_memory_used_mb_peak": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      }
    },
    "handshake_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inter_node_latency_ms",
        "rank_status"
      ],
      "properties": {
        "inter_node_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "rank_status": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "node",
              "status"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 0
              },
              "node": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "READY",
                  "FAILED",
                  "UNKNOWN"
                ]
              }
            }
          }
        }
      }
    }
  }
}
